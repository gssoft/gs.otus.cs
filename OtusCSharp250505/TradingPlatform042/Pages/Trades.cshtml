@* Pages/Trades.cshtml *@
@page
@model TradingPlatform.Pages.TradesModel
@{
    ViewData["Title"] = "Trades";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📈 Trades</h1>
        <div>
            <span class="badge bg-info">Total: @Model.Trades.TotalCount</span>
            <a href="/Trades" class="btn btn-outline-secondary btn-sm ms-2">Refresh</a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Ticker</label>
                    <input type="text"
                           class="form-control"
                           name="selectedTicker"
                           value="@Model.SelectedTicker"
                           placeholder="Enter ticker (e.g., AAA)">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Strategy</label>
                    <input type="text"
                           class="form-control"
                           name="selectedStrategy"
                           value="@Model.SelectedStrategy"
                           placeholder="Enter strategy (e.g., AAA_05s)">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Apply Filters</button>
                    <a href="/Trades" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Таблица сделок -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Recent Trades</h5>
            <span class="badge bg-info">Page @Model.Trades.PageNumber of @Model.Trades.TotalPages</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 600px;">
                <table class="table table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Time</th>
                            <th>Ticker</th>
                            <th>Strategy</th>
                            <th>Side</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Volume</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trade in Model.Trades.Items)
                        {
                            <tr>
                                <td>@trade.Timestamp.ToString("HH:mm:ss")</td>
                                <td><strong>@trade.Ticker</strong></td>
                                <td><small class="text-muted">@trade.Strategy</small></td>
                                <td>
                                    <span class="badge @(trade.Side == "Buy" ? "bg-success" : "bg-danger")">
                                        @trade.Side
                                    </span>
                                </td>
                                <td>@trade.Price.ToString("N2")</td>
                                <td>@trade.Quantity.ToString("N0")</td>
                                <td>@trade.Volume.ToString("N2")</td>
                                <td><span class="badge bg-info">@trade.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Trades.TotalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.Trades.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Trades.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="/Trades?pageNumber=@i&selectedTicker=@Model.SelectedTicker&selectedStrategy=@Model.SelectedStrategy">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
