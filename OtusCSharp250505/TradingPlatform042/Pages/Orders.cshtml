@* Pages/Orders.cshtml *@
@page
@model TradingPlatform.Pages.OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📝 Orders</h1>
        <div>
            <span class="badge bg-info">Total: @Model.Orders.TotalCount</span>
            <a href="/Orders" class="btn btn-outline-secondary btn-sm ms-2">Refresh</a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Ticker</label>
                    <input type="text"
                           class="form-control"
                           name="selectedTicker"
                           value="@Model.SelectedTicker"
                           placeholder="Enter ticker (e.g., AAA)">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Strategy</label>
                    <input type="text"
                           class="form-control"
                           name="selectedStrategy"
                           value="@Model.SelectedStrategy"
                           placeholder="Enter strategy (e.g., AAA_05s)">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Apply Filters</button>
                    <a href="/Orders" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Таблица ордеров -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Orders</h5>
            <span class="badge bg-info">Page @Model.Orders.PageNumber of @Model.Orders.TotalPages</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 600px;">
                <table class="table table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Time</th>
                            <th>Ticker</th>
                            <th>Order #</th>
                            <th>Side</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders.Items)
                        {
                            <tr>
                                <td>@order.Timestamp.ToString("HH:mm:ss")</td>
                                <td><strong>@order.Ticker</strong></td>
                                <td><small class="text-muted">#@order.OrderNumber</small></td>
                                <td>
                                    <span class="badge @(order.Side == "Buy" ? "bg-success" : "bg-danger")">
                                        @order.Side
                                    </span>
                                </td>
                                <td>@order.Price.ToString("N2")</td>
                                <td>@order.Quantity.ToString("N0")</td>
                                <td>
                                    <span class="badge @(order.Status == "Filled" ? "bg-success" : order.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                        @order.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Orders.TotalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.Orders.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Orders.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="/Orders?pageNumber=@i&selectedTicker=@Model.SelectedTicker&selectedStrategy=@Model.SelectedStrategy">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
