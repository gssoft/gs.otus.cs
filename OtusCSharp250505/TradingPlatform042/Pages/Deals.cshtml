@* Pages/Deals.cshtml *@
@page
@model TradingPlatform.Pages.DealsModel
@{
    ViewData["Title"] = "Deals";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>💰 Deals</h1>
        <div>
            <span class="badge bg-info">Total: @Model.Deals.TotalCount</span>
            <a href="/Deals" class="btn btn-outline-secondary btn-sm ms-2">Refresh</a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Ticker</label>
                    <input type="text"
                           class="form-control"
                           name="selectedTicker"
                           value="@Model.SelectedTicker"
                           placeholder="Enter ticker (e.g., AAA)">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Strategy</label>
                    <input type="text"
                           class="form-control"
                           name="selectedStrategy"
                           value="@Model.SelectedStrategy"
                           placeholder="Enter strategy (e.g., AAA_05s)">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Apply Filters</button>
                    <a href="/Deals" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Таблица закрытых сделок -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Closed Deals</h5>
            <span class="badge bg-info">Page @Model.Deals.PageNumber of @Model.Deals.TotalPages</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 600px;">
                <table class="table table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Time</th>
                            <th>Ticker</th>
                            <th>Deal #</th>
                            <th>Side</th>
                            <th>Open Price</th>
                            <th>Close Price</th>
                            <th>Quantity</th>
                            <th>P&L</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var deal in Model.Deals.Items)
                        {
                            <tr>
                                <td>@deal.Timestamp.ToString("HH:mm:ss")</td>
                                <td><strong>@deal.Ticker</strong></td>
                                <td><small class="text-muted">#@deal.DealNumber</small></td>
                                <td>
                                    <span class="badge @(deal.Side == "Buy" ? "bg-success" : "bg-danger")">
                                        @deal.Side
                                    </span>
                                </td>
                                <td>@deal.OpenPrice.ToString("N2")</td>
                                <td>@deal.ClosePrice.ToString("N2")</td>
                                <td>@deal.Qty.ToString("N0")</td>
                                <td class="@(deal.PnL > 0 ? "text-success fw-bold" : deal.PnL < 0 ? "text-danger fw-bold" : "")">
                                    @deal.PnL.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Deals.TotalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.Deals.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Deals.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="/Deals?pageNumber=@i&selectedTicker=@Model.SelectedTicker&selectedStrategy=@Model.SelectedStrategy">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
