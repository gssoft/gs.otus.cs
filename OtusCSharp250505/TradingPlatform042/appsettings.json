{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInfo": {
    "Name": "TradingPlatform",
    "Version": "1.0.0"
  },
  "FileOutput": {
    "PortsFileName": "platform_urls.txt",
    "StatsFileName": "platform_stats.txt",
    "EnableFileOutput": true,
    "OutputDirectory": "Logs"
  },
  "Display": {
    "PauseSeconds": 5,
    "ShowApiEndpoints": true,
    "ShowAllPages": true
  }
}